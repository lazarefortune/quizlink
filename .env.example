# Application environment example (Next.js / Prisma / integrations).
# Copy to .env.local for local (non-Docker) development:
#   cp .env.example .env.local
#
# Docker Compose uses .env.docker (see .env.docker.example), not this file.
# Code source of truth for SMTP: SMTP_FROM / SMTP_PASS (not SMTP_FROM_EMAIL / SMTP_PASSWORD).

# Database
DATABASE_URL=

# Auth
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Optional. Defaults to AUTH_SECRET / NEXTAUTH_SECRET if unset.
AUTH_IP_ADDRESS_PEPPER=

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Email (Nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=

# OpenAI
OPENAI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_PRICE_ID=

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Dev fixtures (DEV only — make install generates DEV_ADMIN_PASSWORD into .env.docker)
# DEV_ADMIN_EMAIL=admin@quizlink.local
# DEV_ADMIN_PASSWORD=change-me
# DEV_ADMIN_NAME=QuizLink Dev Admin

# ---------------------------------------------------------------------------
# PostHog (EU)
# ---------------------------------------------------------------------------
# PROJECT TOKEN (phc_…) — public client/server project token.
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_TOKEN=
# POSTHOG_PROJECT_TOKEN=

# NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
# NEXT_PUBLIC_POSTHOG_PROXY_PATH=

# POSTHOG_HOST=https://eu.i.posthog.com
# POSTHOG_LOGS_URL=https://eu.i.posthog.com/i/v1/logs

# PERSONAL API KEY (phx_…) — BUILD ONLY for source maps. Never NEXT_PUBLIC_.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=

# POSTHOG_RELEASE_NAME=quizlink-web
# POSTHOG_RELEASE_VERSION=
# DEPLOYMENT_ENVIRONMENT=
# POSTHOG_SOURCEMAPS_DISABLED=1

# OBSERVABILITY_TEST_SECRET=
# ENABLE_OBSERVABILITY_TEST=
