# Docker Compose environment example (DEV).
# Copy:  cp .env.docker.example .env.docker
# Use:   make start   (Makefile passes --env-file .env.docker)
#
# Separation:
#   .env.docker  → Compose interpolation + container env (this file)
#   .env.local   → Next.js / host tooling (from .env.example)
#
# Do not put production secrets here.

# -----------------------------------------------------------------------------
# Host-published ports (machine ↔ containers)
# MYSQL_HOST_PORT only remaps the host side. Inside Docker, MySQL stays db:3306.
# -----------------------------------------------------------------------------
APP_PUBLISH_PORT=3000
MYSQL_HOST_PORT=3307
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# -----------------------------------------------------------------------------
# MySQL credentials (Compose builds DATABASE_URL as mysql://USER:PASS@db:3306/DB)
# -----------------------------------------------------------------------------
MYSQL_DATABASE=quizlink
MYSQL_USER=quizlink
MYSQL_PASSWORD=quizlink
MYSQL_ROOT_PASSWORD=quizlink_root_dev

# -----------------------------------------------------------------------------
# Auth / URLs (browser uses localhost; containers use service DNS)
# Generate: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Email — Compose forces SMTP_HOST=mailpit for the app service
# -----------------------------------------------------------------------------
SMTP_FROM=noreply@quizlink.local
SMTP_FROM_NAME=QuizLink

# -----------------------------------------------------------------------------
# Question images (persisted on named volume)
# -----------------------------------------------------------------------------
QUESTION_IMAGE_STORAGE=local
QUESTION_IMAGE_UPLOAD_DIR=/app/storage/question-images

# Hot reload on Docker Desktop / OrbStack (macOS)
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true

# -----------------------------------------------------------------------------
# Dev fixtures (`make fixtures`) — DEV only
# make install generates a strong DEV_ADMIN_PASSWORD into .env.docker (gitignored).
# Never commit a real password. Placeholder below is rejected by fixtures.
# -----------------------------------------------------------------------------
DEV_ADMIN_EMAIL=admin@quizlink.local
DEV_ADMIN_PASSWORD=change-me
DEV_ADMIN_NAME=QuizLink Dev Admin

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLIC_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_PRICE_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_PROXY_PATH=
# AUTH_IP_ADDRESS_PEPPER=
