// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String                   @db.VarChar(255)
  passwordHash            String                   @map("password_hash")
  emailVerifiedAt         DateTime?                @map("email_verified_at")
  preferredLanguage       String                   @default("fr") @map("preferred_language") // "fr" | "en"
  role                    String                   @default("USER") @map("role") // "USER" | "ADMIN"
  coinBalance             Int                      @default(0) @map("coin_balance")
  createdAt               DateTime                 @default(now()) @map("created_at")
  quizzes                 Quiz[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  emailChangeTokens       EmailChangeToken[]
  createdParticipants     Participant[]
  coinTransactions        CoinTransaction[]
  feedbacks               Feedback[]

  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   @db.VarChar(6)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([code])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model EmailChangeToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String   @map("new_email")
  code      String   @db.VarChar(6)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([code])
  @@map("email_change_tokens")
}

model Quiz {
  id          String     @id @default(cuid())
  ownerId     String?    @map("owner_id")
  owner       User?      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  visibility  String // PRIVATE | PUBLIC
  settings    Json // Quiz settings as JSON
  isAnonymous Boolean    @default(false) @map("is_anonymous")
  expiresAt   DateTime?  @map("expires_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  questions   Question[]
  links       QuizLink[]

  @@index([isAnonymous])
  @@index([expiresAt])
  @@map("quizzes")
}

model Question {
  id          String       @id @default(cuid())
  quizId      String       @map("quiz_id")
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type        String // MULTIPLE_CHOICE | CHECKBOX | TRUE_FALSE
  label       String       @db.Text
  image       String?      @db.LongText
  explanation String?      @db.Text // Shown when user gets the question wrong
  order       Int // Order within the quiz
  options     Option[]
  answers     QuizAnswer[]

  @@index([quizId])
  @@map("questions")
}

model Option {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String   @db.Text
  isCorrect  Boolean  @default(false) @map("is_correct")

  @@index([questionId])
  @@map("options")
}

model Participant {
  id                String        @id @default(cuid())
  name              String        @db.VarChar(255)
  email             String?       @db.VarChar(255)
  gender            String?       @db.VarChar(10) // "MALE" | "FEMALE" | "OTHER" | null
  avatar            String?       @db.Text // SVG avatar URL (DiceBear)
  createdByUserId   String?       @map("created_by_user_id")
  createdByUser     User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now()) @map("created_at")
  publicToken       String?       @unique @map("public_token") @db.VarChar(24)
  isPortalEnabled   Boolean       @default(false) @map("is_portal_enabled")
  attempts          QuizAttempt[]
  links             QuizLink[]

  @@index([createdByUserId])
  @@index([publicToken])
  @@map("participants")
}

model QuizLink {
  id                    String        @id @default(cuid())
  quizId                String        @map("quiz_id")
  quiz                  Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  token                 String        @unique @db.VarChar(16)
  participantId         String?       @map("participant_id")
  participant           Participant?  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  allowMultipleAttempts Boolean       @default(true) @map("allow_multiple_attempts")
  createdAt             DateTime      @default(now()) @map("created_at")
  expiresAt             DateTime?     @map("expires_at")
  revokedAt             DateTime?     @map("revoked_at")
  attempts              QuizAttempt[]

  @@index([quizId])
  @@index([token])
  @@index([participantId])
  @@map("quiz_links")
}

model QuizAttempt {
  id            String       @id @default(cuid())
  quizLinkId    String       @map("quiz_link_id")
  quizLink      QuizLink     @relation(fields: [quizLinkId], references: [id], onDelete: Cascade)
  participantId String?      @map("participant_id")
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  startedAt     DateTime     @default(now()) @map("started_at")
  finishedAt    DateTime?    @map("finished_at")
  score         Float? // Score as percentage (0-100)
  status        String       @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | ABANDONED
  answers       QuizAnswer[]

  @@index([quizLinkId])
  @@index([participantId])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id                String      @id @default(cuid())
  attemptId         String      @map("attempt_id")
  attempt           QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String      @map("question_id")
  question          Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOptionIds Json        @map("selected_option_ids") // Array of option IDs
  isCorrect         Boolean     @default(false) @map("is_correct")
  answeredAt        DateTime    @default(now()) @map("answered_at")
  timeSpent         Int?        @map("time_spent") // Time spent in seconds

  @@index([attemptId])
  @@index([questionId])
  @@map("quiz_answers")
}

model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // Positive for credit, negative for debit
  reason    String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("coin_transactions")
}

model CoinPack {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(255) // e.g., "STARTER", "BOOST", "PRO"
  displayName   String   @map("display_name") @db.VarChar(255) // e.g., "Pack Starter"
  coins         Int // Number of coins in this pack
  price         Int // Price in cents (e.g., 500 for 5.00€)
  stripePriceId String?  @map("stripe_price_id") @db.VarChar(255) // Stripe price_id (price_xxx)
  isActive      Boolean  @default(true) @map("is_active")
  isPopular     Boolean  @default(false) @map("is_popular") // Highlight as popular pack
  order         Int      @default(0) // Display order
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([name])
  @@index([isActive])
  @@index([order])
  @@map("coin_packs")
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String   @db.VarChar(50) // "BUG" | "SUGGESTION" | "FEEDBACK"
  message   String   @db.Text
  page      String   @db.VarChar(500)
  userAgent String   @map("user_agent") @db.VarChar(500)
  status    String   @default("NEW") @db.VarChar(50) // "NEW" | "IN_PROGRESS" | "DONE"
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("feedbacks")
}
