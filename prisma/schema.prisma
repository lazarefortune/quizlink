// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String                   @db.VarChar(255)
  passwordHash            String?                  @map("password_hash")
  googleId                String?                  @unique @map("google_id")
  emailVerifiedAt         DateTime?                @map("email_verified_at")
  preferredLanguage       String                   @default("fr") @map("preferred_language") // "fr" | "en"
  role                    String                   @default("USER") @map("role") // "USER" | "ADMIN"
  coinBalance             Int                      @default(0) @map("coin_balance")
  lastLoginAt             DateTime?                @map("last_login_at")
  createdAt               DateTime                 @default(now()) @map("created_at")
  termsAcceptedAt         DateTime?                @map("terms_accepted_at")
  termsVersion            String?                  @map("terms_version") @db.VarChar(20)
  privacyAcceptedAt       DateTime?                @map("privacy_accepted_at")
  privacyVersion          String?                  @map("privacy_version") @db.VarChar(20)
  welcomeEmailSentAt      DateTime?                @map("welcome_email_sent_at")
  notifyQuizResponses     Boolean                  @default(true) @map("notify_quiz_responses")
  notifyProductUpdates    Boolean                  @default(false) @map("notify_product_updates")
  notifyMarketing         Boolean                  @default(false) @map("notify_marketing")
  avatar                  String?                  @db.Text
  avatarConfig            String?                  @map("avatar_config") @db.Text
  quizzes                 Quiz[]
  createdEditorialQuizzes Quiz[]                   @relation("QuizCreatedByAdmin")
  updatedEditorialQuizzes Quiz[]                   @relation("QuizUpdatedByAdmin")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  emailChangeTokens       EmailChangeToken[]
  createdParticipants     Participant[]
  coinTransactions        CoinTransaction[]
  quizUnlocks             QuizUnlock[]
  feedbacks               Feedback[]
  lifecycleEvents         UserLifecycleEvent[]
  authEvents              UserAuthEvent[]
  userSubscriptions       UserSubscription[]
  subscriptionCoinGrants  SubscriptionCoinGrant[]

  @@map("users")
}

model UserLifecycleEvent {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType String   @map("event_type") @db.VarChar(50) // "SIGNUP" | "ACCOUNT_DELETION"
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("user_lifecycle_events")
}

model UserAuthEvent {
  id            String    @id @default(cuid())
  userId        String?   @map("user_id")
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType     String    @map("event_type") @db.VarChar(50) // LOGIN_SUCCESS | LOGIN_FAILURE
  authProvider  String?   @map("auth_provider") @db.VarChar(50) // credentials | google
  ipAddressHash String?   @map("ip_address_hash") @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(500)
  failureReason String?   @map("failure_reason") @db.VarChar(100)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("user_auth_events")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   @db.VarChar(6)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([code])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model EmailChangeToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String   @map("new_email")
  code      String   @db.VarChar(6)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([code])
  @@map("email_change_tokens")
}

enum QuizStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Quiz {
  id               String      @id @default(cuid())
  ownerId          String?     @map("owner_id")
  owner            User?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdByAdminId String?     @map("created_by_admin_id")
  createdByAdmin   User?       @relation("QuizCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  updatedByAdminId String?   @map("updated_by_admin_id")
  updatedByAdmin   User?     @relation("QuizUpdatedByAdmin", fields: [updatedByAdminId], references: [id], onDelete: SetNull)
  name             String
  visibility       String // PRIVATE | PUBLIC
  status           QuizStatus  @default(ACTIVE)
  publishedAt      DateTime?   @map("published_at")
  featuredAt       DateTime?   @map("featured_at")
  settings         Json // Quiz settings as JSON
  isAnonymous      Boolean     @default(false) @map("is_anonymous")
  expiresAt        DateTime?   @map("expires_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  questions        Question[]
  links            QuizLink[]
  unlocks          QuizUnlock[]
  responseStats    QuizResponseStats?
  questionResponseStats QuizQuestionResponseStats[]

  @@index([isAnonymous])
  @@index([featuredAt])
  @@index([status])
  @@index([createdByAdminId])
  @@index([updatedByAdminId])
  @@index([expiresAt])
  @@map("quizzes")
}

model Question {
  id          String       @id @default(cuid())
  quizId      String       @map("quiz_id")
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type        String // MULTIPLE_CHOICE | CHECKBOX | TRUE_FALSE
  label       String       @db.Text
  image       String?      @db.LongText
  imageKey    String?      @map("image_key") @db.VarChar(512)
  explanation String?      @db.Text // Shown when user gets the question wrong
  order       Int // Order within the quiz
  options         Option[]
  answers         QuizAnswer[]
  questionTimings QuizAttemptQuestion[]
  responseStats   QuizQuestionResponseStats[]

  @@index([quizId])
  @@map("questions")
}

model Option {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String   @db.Text
  isCorrect  Boolean  @default(false) @map("is_correct")

  @@index([questionId])
  @@map("options")
}

model Participant {
  id                String        @id @default(cuid())
  name              String        @db.VarChar(255)
  email             String?       @db.VarChar(255)
  gender            String?       @db.VarChar(10) // "MALE" | "FEMALE" | "OTHER" | null
  avatar            String?       @db.Text // SVG avatar URL (DiceBear)
  createdByUserId   String?       @map("created_by_user_id")
  createdByUser     User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now()) @map("created_at")
  publicToken       String?       @unique @map("public_token") @db.VarChar(24)
  isPortalEnabled   Boolean       @default(false) @map("is_portal_enabled")
  attempts          QuizAttempt[]
  links             QuizLink[]

  @@index([createdByUserId])
  @@index([publicToken])
  @@map("participants")
}

model QuizLink {
  id                      String        @id @default(cuid())
  quizId                  String        @map("quiz_id")
  quiz                    Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  token                   String        @unique @db.VarChar(16)
  participantId           String?       @map("participant_id")
  participant             Participant?  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  allowMultipleAttempts   Boolean       @default(true) @map("allow_multiple_attempts")
  createdAt               DateTime      @default(now()) @map("created_at")
  expiresAt               DateTime?     @map("expires_at")
  revokedAt               DateTime?     @map("revoked_at")
  responsesStartedAt      DateTime?     @map("responses_started_at")
  lastResponseAt          DateTime?     @map("last_response_at")
  acceptingResponsesUntil DateTime?     @map("accepting_responses_until")
  detailsVisibleUntil     DateTime?     @map("details_visible_until")
  detailsPurgedAt         DateTime?     @map("details_purged_at")
  unlockedUntil           DateTime?     @map("unlocked_until")
  attempts                QuizAttempt[]
  anonymousStats          QuizLinkAnonymousStats?

  @@index([quizId])
  @@index([token])
  @@index([participantId])
  @@index([acceptingResponsesUntil])
  @@index([detailsVisibleUntil])
  @@index([unlockedUntil])
  @@map("quiz_links")
}

model QuizLinkAnonymousStats {
  quizLinkId       String    @id @map("quiz_link_id")
  quizLink         QuizLink  @relation(fields: [quizLinkId], references: [id], onDelete: Cascade)
  openCount        Int       @default(0) @map("open_count")
  startedCount     Int       @default(0) @map("started_count")
  completedCount   Int       @default(0) @map("completed_count")
  scoreSum         Float     @default(0) @map("score_sum")
  scoreCount       Int       @default(0) @map("score_count")
  bestScore        Float?    @map("best_score")
  lowestScore      Float?    @map("lowest_score")
  lastOpenedAt     DateTime? @map("last_opened_at")
  lastStartedAt    DateTime? @map("last_started_at")
  lastCompletedAt  DateTime? @map("last_completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("quiz_link_anonymous_stats")
}

model QuizAttempt {
  id            String       @id @default(cuid())
  quizLinkId    String       @map("quiz_link_id")
  quizLink      QuizLink     @relation(fields: [quizLinkId], references: [id], onDelete: Cascade)
  participantId String?      @map("participant_id")
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  startedAt       DateTime              @default(now()) @map("started_at")
  finishedAt      DateTime?             @map("finished_at")
  score           Float? // Score as percentage (0-100)
  status          String                @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | ABANDONED
  identityMode      String   @default("ANONYMOUS") @map("identity_mode") // ANONYMOUS | PSEUDONYM | NAME_EMAIL
  participantName   String?  @map("participant_name") @db.VarChar(100)
  participantEmail  String?  @map("participant_email") @db.VarChar(191)
  totalQuestions    Int?     @map("total_questions")
  durationSeconds Int?                  @map("duration_seconds")
  answers         QuizAnswer[]
  questionTimings QuizAttemptQuestion[]

  @@index([quizLinkId])
  @@index([quizLinkId, status, finishedAt])
  @@index([quizLinkId, finishedAt])
  @@index([quizLinkId, startedAt])
  @@index([participantId])
  @@index([identityMode])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id                String      @id @default(cuid())
  attemptId         String      @map("attempt_id")
  attempt           QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String      @map("question_id")
  question          Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOptionIds Json        @map("selected_option_ids") // Array of option IDs
  isCorrect         Boolean     @default(false) @map("is_correct")
  answeredAt        DateTime    @default(now()) @map("answered_at")
  timeSpent         Int?        @map("time_spent") // Time spent in seconds
  expired           Boolean     @default(false)

  @@index([attemptId])
  @@index([questionId])
  @@index([questionId, isCorrect])
  @@index([questionId, expired])
  @@map("quiz_answers")
}

model QuizAttemptQuestion {
  id               String      @id @default(cuid())
  attemptId        String      @map("attempt_id")
  attempt          QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String      @map("question_id")
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)
  startedAt        DateTime    @map("started_at")
  deadlineAt       DateTime?   @map("deadline_at")
  answeredAt       DateTime?   @map("answered_at")
  timeSpentSeconds Int?        @map("time_spent_seconds")
  expired          Boolean     @default(false)
  createdAt        DateTime    @default(now()) @map("created_at")

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("quiz_attempt_questions")
}

enum QuizUnlockType {
  SINGLE_QUIZ
  SUBSCRIPTION
  ADMIN
  PROMO
}

enum QuizUnlockSource {
  COINS
  STRIPE_SUBSCRIPTION
  MANUAL
}

model QuizUnlock {
  id         String           @id @default(cuid())
  quizId     String           @map("quiz_id")
  userId     String           @map("user_id")
  type       QuizUnlockType
  source     QuizUnlockSource
  coinsSpent Int?             @map("coins_spent")
  startsAt   DateTime         @default(now()) @map("starts_at")
  expiresAt  DateTime         @map("expires_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  quiz       Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId, userId])
  @@index([userId, expiresAt])
  @@index([quizId, expiresAt])
  @@map("quiz_unlocks")
}

model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // Positive for credit, negative for debit
  reason    String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("coin_transactions")
}

model CoinPack {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(255) // e.g., "STARTER", "BOOST", "PRO"
  displayName   String   @map("display_name") @db.VarChar(255) // e.g., "Pack Starter"
  coins         Int // Number of coins in this pack
  price         Int // Price in cents (e.g., 500 for 5.00€)
  stripePriceId String?  @map("stripe_price_id") @db.VarChar(255) // Stripe price_id (price_xxx)
  isActive      Boolean  @default(true) @map("is_active")
  isPopular     Boolean  @default(false) @map("is_popular") // Highlight as popular pack
  order         Int      @default(0) // Display order
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([name])
  @@index([isActive])
  @@index([order])
  @@map("coin_packs")
}

model Feedback {
  id             String   @id @default(cuid())
  userId         String?  @map("user_id")
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  quizId         String?  @map("quiz_id") @db.VarChar(191)
  type           String   @db.VarChar(50)
  rating         Int?
  message        String?  @db.Text
  featureRequest String?  @map("feature_request") @db.Text
  category       String?  @db.VarChar(50)
  metadata       Json?
  page           String   @db.VarChar(500)
  userAgent      String   @map("user_agent") @db.VarChar(500)
  status         String   @default("NEW") @db.VarChar(50) // "NEW" | "IN_PROGRESS" | "DONE"
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("feedbacks")
}

model AppSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model UserSubscription {
  id String @id @default(cuid())

  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionCoinGrants SubscriptionCoinGrant[]

  provider String @default("STRIPE")

  stripeCustomerId String? @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  stripePriceId String? @map("stripe_price_id")

  plan SubscriptionPlan @default(PRO)
  status SubscriptionStatus

  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd DateTime? @map("current_period_end")
  cancelAtPeriodEnd Boolean @default(false) @map("cancel_at_period_end")
  canceledAt DateTime? @map("canceled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([userId, currentPeriodEnd])
  @@index([stripeCustomerId])

  @@map("user_subscriptions")
}

model SubscriptionCoinGrant {
  id String @id @default(cuid())

  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId String @map("subscription_id")
  subscription UserSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  stripeSubscriptionId String @map("stripe_subscription_id")
  stripeInvoiceId String? @map("stripe_invoice_id")
  stripePriceId String? @map("stripe_price_id")

  coinsGranted Int @map("coins_granted")

  periodStart DateTime @map("period_start")
  periodEnd DateTime @map("period_end")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([stripeSubscriptionId, periodStart, periodEnd])
  @@index([userId, createdAt])
  @@index([subscriptionId])
  @@map("subscription_coin_grants")
}

enum SubscriptionPlan {
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

model QuizResponseStats {
  id                     String   @id @default(cuid())
  quizId                 String   @unique @map("quiz_id")
  quiz                   Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  totalStarted           Int      @default(0) @map("total_started")
  totalCompleted         Int      @default(0) @map("total_completed")
  totalAbandoned         Int      @default(0) @map("total_abandoned")
  totalScore             Float    @default(0) @map("total_score")
  totalPossibleScore     Float    @default(0) @map("total_possible_score")
  totalDurationSeconds   Int      @default(0) @map("total_duration_seconds")
  completedDurationCount Int      @default(0) @map("completed_duration_count")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@index([quizId])
  @@map("quiz_response_stats")
}

model QuizQuestionResponseStats {
  id                     String   @id @default(cuid())
  quizId                 String   @map("quiz_id")
  quiz                   Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionId             String   @map("question_id")
  question               Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  totalAnswers           Int      @default(0) @map("total_answers")
  correctAnswers         Int      @default(0) @map("correct_answers")
  expiredAnswers         Int      @default(0) @map("expired_answers")
  totalTimeSpentSeconds  Int      @default(0) @map("total_time_spent_seconds")
  timeSpentCount         Int      @default(0) @map("time_spent_count")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@unique([quizId, questionId])
  @@index([quizId])
  @@index([questionId])
  @@map("quiz_question_response_stats")
}
